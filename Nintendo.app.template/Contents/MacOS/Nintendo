#!/bin/bash
# macOS app launcher for the controller project. It remembers the project
# folder and asks again if the folder was moved or deleted.
set -u

APP_NAME="Nintendo"
SETTINGS_DIR="$HOME/Library/Application Support/$APP_NAME"
PROJECT_FILE="$SETTINGS_DIR/project-path"
DEFAULT_PROJECT="$HOME/Projects/Astris_gamepad"

dialog() {
    /usr/bin/osascript -e "display alert \"$APP_NAME\" message \"$1\" as warning" >/dev/null
}

is_project() {
    [ -x "$1/launch_astris.sh" ] && [ -x "$1/launch_azahar.sh" ]
}

project=""
if [ -f "$PROJECT_FILE" ]; then
    project="$(<"$PROJECT_FILE")"
fi
if ! is_project "$project" && is_project "$DEFAULT_PROJECT"; then
    project="$DEFAULT_PROJECT"
fi
if ! is_project "$project"; then
    project="$(/usr/bin/osascript -e 'POSIX path of (choose folder with prompt "Select the Astris_gamepad folder")' 2>/dev/null || true)"
fi

if ! is_project "$project"; then
    dialog "The selected folder is not an Astris_gamepad project."
    exit 1
fi

/bin/mkdir -p "$SETTINGS_DIR"
printf '%s\n' "$project" > "$PROJECT_FILE"

bring_forward() {
    /usr/bin/open -a "$1"
    dialog "$1 is already running. It has been brought to the front; its controller helper was left untouched."
}

# Only one emulator can own the Ares helper at a time. Most importantly, do
# not invoke a second launcher: its cleanup path could stop the active one.
if /usr/bin/pgrep -x Astris >/dev/null; then
    bring_forward "Astris"
    exit 0
fi
if /usr/bin/pgrep -x azahar >/dev/null; then
    bring_forward "Azahar"
    exit 0
fi

choice="$(/usr/bin/osascript -e 'choose from list {"Astris", "Azahar"} with title "Nintendo" with prompt "Open with Cosmic Byte Ares controller support:" default items {"Astris"}' 2>/dev/null || true)"
case "$choice" in
    Astris)
        launcher="$project/launch_astris.sh"
        ;;
    Azahar)
        launcher="$project/launch_azahar.sh"
        ;;
    *)
        exit 0
        ;;
esac

# Detach the selected launcher from this app bundle. Force-quitting Nintendo
# can therefore never stop an already-running emulator or its helper.
/usr/bin/nohup "$launcher" > /tmp/nintendo-launcher.log 2>&1 < /dev/null &
